# Environment / secrets
# Contains C2_HOST_IP and DOWNLOAD_TOKEN -- machine-specific, never commit
.env

# PKI material — regenerated by launch.sh on each run, never committed.
# CA private key must stay offline; committing it defeats the trust model.
certs/ca.key
certs/ca.crt
certs/ca.srl
certs/controller.key
certs/controller.crt
certs/implant.key
certs/implant.crt
certs/nginx.key
certs/nginx.crt
certs/whitelist.txt

# Auto-generated C header — built from certs/ by generate_certs.sh
c2-server/C2-Server-and-Implant/include/implant_certs.h

# Generated shellcode artifacts
# shellcode-generation/ artifacts are built on the host with:
#   make HOST_IP=<ip>  (in exfil-server/shellcode-generation/)
# then committed so Docker COPY picks them up directly.
# Rebuild whenever the HOST_IP changes.
shellcode.bin
exploit.js.bak

# Compiled binaries
# Docker rebuilds these from source -- no need to track them
c2-server/C2-Server-and-Implant/bin/

# Runtime exfil data
# Volume-mounted at runtime, not part of the project
exfil-data/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
